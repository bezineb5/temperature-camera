[Unit]
Description=Temperature Camera Streaming Server
Wants=network-online.target
After=network.target network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/TemperatureCamera
# If the image is mirrored/upside down, add --flip-h / --flip-v here, then `make service-update`
ExecStart=/home/pi/TemperatureCamera/venv/bin/python /home/pi/TemperatureCamera/main.py --flip-h
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# Logging goes straight to the journal (see `make service-logs`)
StandardOutput=journal
StandardError=journal

# Hardening: fully read-only system, nothing is written at runtime (logs go
# to the journal via StandardOutput=journal). /dev/i2c-1 stays reachable.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict

# Performance settings (MemoryLimit sized for a 512 MB Pi Zero W; the app uses ~100 MB)
Nice=0
CPUQuota=80%
MemoryLimit=300M

[Install]
WantedBy=multi-user.target
